# Copy to .env and fill in.  cp .env.example .env
NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# Claude API key from https://platform.claude.com (Settings → API keys).
# Leave empty to run with the question bank only (no new questions, no explanations).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Cheaper models for explanations / Ask Claude and for suggested marking (defaults shown)
# OPENAI_MODEL_EXPLAIN=gpt-4.1-mini
# OPENAI_MODEL_MARK=gpt-4.1-mini
# Safety cap: Claude features pause for the rest of the month after this many dollars.
AI_MONTHLY_LIMIT_USD=10

# Where the database lives (default: ./data/tutor.db)
# DB_PATH=/opt/amer-tutor/data/tutor.db

# Secret for the weekly report link used by the Friday email task (at least 24 characters).
# REPORT_TOKEN=

# Optional Stripe Checkout integration (requires live merchant setup and signed webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://example.com
PLATFORM_COMMISSION_BPS=1500
